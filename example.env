# ID клиента, секретный ключ и shop_id выдаётся при регистрации кошелька
YKASSA_SECRET_KEY=your_secret_key_123123123
YKASSA_SHOP_ID=1234567

# URL куда возвращать пользователя при оплате (требует YKassa Api)
RETURN_URL=http://localhost:5000/api/payment

# Время в секундах, обозначающее период проверки статуса оплаты
CHECK_PAYMENT_STATUS_PERIOD=5

# Настройки баз данных
DATABASE_NAME=payments_status.db
REDIS_URL=redis://youmoney-redis:6379/0

# Бот токен и ID чата выдаётся при регистрации бота в Телеграм
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789

# Настройки, обозначающие то, на каком url запускается сервер Flask
API_HOST=localhost
API_PORT=5000

